# ─── Core ───────────────────────────────────────────
ENV=development
DATABASE_URL=postgresql+psycopg://agentguard:CHANGE_ME@postgres:5432/agentguard
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRY_HOURS=12
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Rate limiting ──────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
ALLOW_LOCAL_RATE_LIMIT_FALLBACK=false

# ─── Integration token encryption (Fernet) ──────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# ─── OAuth (Google / Slack) ─────────────────────────
OAUTH_REDIRECT_BASE=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/?billing=success
STRIPE_CANCEL_URL=http://localhost:8000/?billing=cancel

# ─── SMTP (Resend / SendGrid / etc.) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ─── Enterprise SCIM ────────────────────────────────
SCIM_BEARER_TOKEN=
SCIM_ORG_ID=

# ─── Postgres (docker-compose ke liye) ──────────────
POSTGRES_PASSWORD=CHANGE_ME
